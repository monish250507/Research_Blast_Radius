# Research Blast Radius configuration (all optional).
# Defaults: provider=stub (deterministic no-LLM mode), db=sqlite fallback.

# --- Storage ---
# Uncomment to use PostgreSQL (docker compose up -d db first):
# RBR_DB_URL=postgresql+psycopg://rbr:rbr@localhost:5432/rbr
RBR_DB_URL=sqlite+pysqlite:///./rbr_local.db

# --- LLM provider ---
# stub | openai | anthropic | openai_compatible
RBR_LLM_PROVIDER=stub
RBR_LLM_MODEL=
RBR_LLM_API_KEY=
RBR_LLM_BASE_URL=
RBR_LLM_TEMPERATURE=0.0

# --- Logging ---
RBR_LOG_LEVEL=INFO
